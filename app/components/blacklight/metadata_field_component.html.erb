<%= render(@layout.new(field: @field)) do |component| %>
  <% component.with_label do %>
    <%= label %>
  <% end %>

  <% component.with_value do %>
    <%# <%= label == "FAST Subject Headings:" %>
    <% if label != "FAST Subject Headings:" %>
      <%= @field.render %>
    <% elsif label == "FAST Subject Headings:"%>
      <%# <%= alt_labe %>
      <%# <%= @field.methods %>

        <% @field.document[:subject_fast].each do |x| %>
          <span itemprop="<%= label %>"> 
            <a href="/catalog?f%5Bsubject_fast_ssim%5D%5B%5D=<%= x %>" class="show-page-label">
              <%= OclcSubjectFastService.new(x).fast_data %>
            </a>
          </span>
          <%# simplifies pseudo semicolon delimiter %>
          <div></div>
        <% end %>
    <% end %>

  <% end %>
<% end %>
