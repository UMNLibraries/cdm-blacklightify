<div class="card my-3">
  <div class="card-header mb-0 h6" href="#item-details">More Like This
    <a class="p-2 sr-only sr-only-focusable" href="#item-details">Skip to item details</a>
  </div>
  
  <div class="card-body">
    <ul class="list-group list-group-horizontal-md justify-content-center">
      <% @document.more_like_this.each do |document| %>
        <li class="mlt-lgi list-group-item">
          <%= link_to_document(document, image_tag(document.cdm_thumbnail), counter: nil, class: "mlt-thumb d-flex justify-content-center", tabindex:"-1") %>
          <%= link_to_document(document, document[:title], counter: nil, class: "text-center text-truncate") %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
