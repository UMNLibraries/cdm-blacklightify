<div class="my-5 mlt-c">
  <div class="h2 pb-3 mb-0" href="#item-details">More Like This
    <a class="p-2 sr-only sr-only-focusable" href="#item-details">Skip to item details</a>
  </div>
  
  <div class="card-body" style="background-color: yellow;">
    <ul class="list-group list-group-horizontal-md" style="background-color: pink;">
      <% @document.more_like_this.each do |document| %>
        <li class="mlt-lgi list-group-item">
          <%= link_to_document(document, image_tag(document.cdm_thumbnail), counter: nil, class: "mlt-thumb d-flex justify-content-center") %>
          <%= link_to_document(document, document[:title], counter: nil, class: "mlt-thumb-title d-flex justify-content-center text-center", tabindex:"-1") %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
