<div class="card my-3">
  <div class="card-header mb-0 h6">More Like This</div>
  <div class="card-body">
    <ul class="list-group list-group-horizontal justify-content-center">
      <% @document.more_like_this.each do |document| %>
        <li class="list-group-item">
          <%= link_to solr_document_path(document) do %>
            <%= image_tag(document.cdm_thumbnail, { alt: document.fetch(:title_ssi), class: 'rounded mx-auto d-block mt-1' }) %>
            <h5 class="mlt-title mb-0 mt-3" style="font-size: 1rem;"><%= document.fetch(:title_ssi).truncate(30) %></h5>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
