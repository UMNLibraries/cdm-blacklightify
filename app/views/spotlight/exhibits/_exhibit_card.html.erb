<div class="col mb-3">
  <div class="card border-0 h-100">
    <%= link_to exhibit, aria: { hidden: true  }, tabindex: '-1' do %>
      <% if exhibit.thumbnail.present? && exhibit.thumbnail.iiif_url %>
        <%= image_tag(exhibit.thumbnail.iiif_url, class: 'card-img',  alt: '', role: 'presentation', skip_pipeline: true) %>
      <% else %>
        <%= image_tag 'spotlight/default_thumbnail.jpg', class: 'card-img default-thumbnail',  alt: '', role: 'presentation' %>
      <% end %>
    <% end %>
    
    <div class="card-body">
      <%= content_tag :h3, class: 'card-title', aria: { describedby: "exhibit-description-#{exhibit.to_param}" } do %>
        <%= link_to exhibit do %>
          <span class="title-alt" data-text="title"><%= exhibit.title %><i class="arrow right"></i></span>
        <% end %>
      <% end %>
      <%= content_tag :div, id: "exhibit-description-#{exhibit.to_param}" do %>
        <% if exhibit.description %>
          <p class="description">
            <%= exhibit.description %>
          </p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>