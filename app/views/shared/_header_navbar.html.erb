<%# nav & search form on homepage, with logos and search bar %>
<%= render partial: 'shared/header_logos' %>

<nav aria-label="Main" class="d-flex flex-column container-fluid umn-nav" id="umn-main-nav">
  <div class="row mb-auto" id="main-nav">
    <a class="col-md-auto col-12 text-center" href="/" id="umedia">UMedia</a>
    <a class="col-md-auto col-12 text-center" href="/">About</a>
    <a class="col-md-auto col-12 text-center" href="/">How to use</a>
    <a class="col-md-auto col-3 text-center" href="/">Give us feedback</a>
  </div>

  <div class="mt-auto mb-auto main-search">
    <%- unless params[:controller] == 'transcript' %> 
      <%= content_tag :div, role: 'navigation', aria: { label: t('blacklight.search.header') } do %>
        <div class="<%= container_classes %>" aria-label="Search UMedia resources">
          <%# render_search_bar  %>
	  <%# render "blacklight/search_form" %>
     <!-- <form class="search-form" action="/catalog" method="get">
            <input type="text" name="q" placeholder="Search..." class="form-control">
            <button type="submit" class="btn btn-primary">Search</button>
          </form> -->
	  <%= render Blacklight::SearchBarComponent.new(url: search_action_url, params: search_state&.params_for_search&.except(:qt) || {}) %>
        </div>
      <% end %>
    <%- end %>
  </div>

  <div class="mt-auto row flex-row-reverse" id="main-image-attribute">
    <p>
      <a href="/">Emma V. White Co., 1926, Andersen Horticultural Library</a><br>
    </p>
  </div>
</nav>
