<%= render partial: 'shared/header_logos' %>
<%# nav & search bar for /catalog path. does not render for item page %>
<% if action_name != 'show' %>
  <nav aria-label="Main" class="d-flex flex-column container-fluid umn-nav">
    <div class="row" id="main-nav">
      <a class="col-md-auto col-12 text-center" href="/" id="umedia">UMedia</a>
      <a class="col-md-auto col-3 text-center" href="/">Collections</a>
      <a class="col-md-auto col-3 text-center" href="/">Subjects</a>
      <a class="col-md-auto col-3 text-center" href="/">Formats</a>
      <a class="col-md-auto col-3 text-center" href="/">Help</a>
    </div>

    <div id="main-search" class="catalog-main-nav">
      <%- unless params[:controller] == 'transcript' %> 
        <%= content_tag :div, role: 'navigation', aria: { label: t('blacklight.search.header') } do %>
          <div class="<%= container_classes %>" aria-label="Search UMedia resources">
            <%= render_search_bar  %>
          </div>
        <% end %>
      <%- end %>
    </div>
  </nav>
<% end %>
