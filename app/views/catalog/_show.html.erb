<!-- Viewer -->
<div data-viewer-type="<%=document._source['viewer_type_ssi']%>">
  <% case document._source['viewer_type_ssi'] %>
    <% when 'image' %>
      <%= render partial: 'viewers/uv_image', locals: { document: document } %>
    <% when 'kaltura_audio' %>
      <%= render partial: 'viewers/uv_audio', locals: { document: document } %>
    <% when 'kaltura_video' %>
      <%= render partial: 'viewers/uv_video', locals: { document: document } %>
    <% when 'kaltura_audio_playlist' %>
      <%= render partial: 'viewers/uv_audio_playlist', locals: { document: document } %>
    <% else %>
      <%= render partial: 'viewers/uv_iiif_manifest', locals: { document: document } %>
  <% end %>
</div>
<!-- presentation mode link -->
<div class="d-flex justify-content-center mb-3 mt-2">
  <%= link_to "Link to fullscreen", solr_document_path(:fullscreen=>true) %>
</div>
<!-- content notice-->
<div id="content-notice">
  <b>Content notice:</b> Please note that some historical materials may contain harmful content and/or descriptions. <a href="">Learn how we’re addressing it</a>. 
</div>
<hr>
<!-- More Like This Component -->
<%= render(Umedia::Document::MoreLikeThisComponent.new(document: document)) %>
<hr>
<!-- Metadata Fields -->
<% doc_presenter = document_presenter(document) %>
<% if transcript_tab %>
  <div class="row">
    <div class="col-lg-9">
      <%= tabs do |c| %>
        <% c.tab 'Details' do %>
          <%= render partial: "item_details" %>
        <% end %>
        <% if @document[:attachment_format] == "iiif" && @document[:attachment].end_with?(".jp2") %>
          <% c.tab 'Attachment', link_class: 'ml-3' do %>
            <%= render partial: 'viewers/uv_image', locals: { document: document } %>
          <% end %>
        <% elsif @document[:attachment].end_with?(".pdf") %>
          <% c.tab 'PDF Transcript', link_class: 'ml-3' do %>
            <%= render partial: 'pdf_viewer', locals: { document: document } %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="col-lg-3">
      <%= render 'show_tools' %>
    </div>
  </div>
<% else %>
  <div class="row">
    <div class="col-lg-9">
      <%= tabs do |c| %>
        <% c.tab 'Details' do %>
          <%= render partial: "item_details" %>
        <% end %>
        <% c.tab 'Transcript', link_class: 'ml-3' do %>
          <%= render template: "transcript/index" %> 
        <% end %>
      <% end %>
    </div>
    <div class="col-lg-3">
      <%= render 'show_tools' %>
    </div>
  </div>
<% end %>

<script>
  const manifest = uv.options.data.iiifManifestId;
  const btn = document.querySelector(".ml-3");

  btn.addEventListener("click", () => {
    var uv = UV.init(
      "uv",
      {
        manifest: manifest,
        config: "/uv/config.json",
      },
    );
  });
</script>
