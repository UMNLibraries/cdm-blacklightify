<!-- Navigation buttons: Back to search, Start over -->
<div class="constraints-container">
  <%= link_to "Start over", search_action_path({}), class: "btn btn-primary" %>
  <%= link_to "Back to search", search_action_path(search_session), class: "btn btn-back-to-search" %>
</div>

<!-- Viewer (render if manifest available OR if it's a Kaltura media item) -->
<% viewer_type = document._source['viewer_type_ssi']&.downcase %>
<% is_kaltura_media = ['kaltura_audio', 'kaltura_video', 'kaltura_audio_playlist'].include?(viewer_type) %>
<% if cdm_manifest_available?(document.id) || is_kaltura_media %>
  <% begin %>
    <% case viewer_type %>
      <% when 'image' %>
        <%= render partial: 'viewers/uv_image', locals: { document: document } %>
      <% when 'kaltura_audio' %>
        <%= render partial: 'viewers/uv_audio', locals: { document: document } %>
      <% when 'kaltura_video' %>
        <%= render partial: 'viewers/uv_video', locals: { document: document } %>
      <% when 'kaltura_audio_playlist' %>
        <%= render partial: 'viewers/uv_audio_playlist', locals: { document: document } %>
      <% else %>
        <!-- Default to IIIF manifest viewer when viewer_type is missing or unknown -->
        <%= render partial: 'viewers/uv_iiif_manifest', locals: { document: document } %>
    <% end %>
  <% rescue => e %>
    <!-- Silently skip viewer if it fails -->
  <% end %>
<% end %>

<!-- More Like This Component -->
<%= render(Umedia::Document::MoreLikeThisComponent.new(document: document)) %>

<div id="item-content" class="row">
  <div class="col-lg-9">
    <!-- presentation mode link -->
    <div class="d-flex justify-content-center mb-3 mt-2" id="fullscreen-link">
      <%= link_to "Link to fullscreen", context_aware_solr_document_path(document, fullscreen: true) %>
    </div>

    <!-- content notice-->
    <div class="my-4" id="content-notice">
      <a href=""><b>Contact us about this resource</b></a>. 
    </div>

    <!-- Metadata Fields -->
    <% doc_presenter = document_presenter(document) %>
    <div>
      <%= render partial: "tabs" %>
    </div>
  </div>

  <div class="col-lg-3 mb-5 mb-lg-0">
    <%= render 'show_sidebar' %>
  </div>
</div>

<script>
  toggleTooltip() 
</script>