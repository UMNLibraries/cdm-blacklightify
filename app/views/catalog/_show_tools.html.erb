<% document = @document if local_assigns[:document].nil? %>
<% if show_doc_actions? document %>
  <div class="show-tools m-0">
    <ul class="list-group list-group-flush">
      <% document_actions(document).each do |action| %>
        <% next if action.key == :citation %>
        <li class="list-group-item">
          <%= render(Blacklight::Document::ActionComponent.new(action: action, document: document, url_opts: Blacklight::Parameters.sanitize(params.to_unsafe_h))) %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
