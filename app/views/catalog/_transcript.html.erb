<%# partial which renders in tab %>

<div>
  <%- @response.documents.sort_by { |x| x['title_ssi'][/\d+/].to_i }.each do |doc| %>
    <% if !doc['transcription_tesi'].present? %>
      <div class="transcription m-3">
        <h3 class="title"><%= doc['title_ssi'] %></h3>
        <p><%= doc['transcription_tesi'] %></p>
      </div>
    <% else %>
      <div id="transcript_content"></div>
    <% end %>
  <% end %>
</div>

<script>
  let transcriptPath = "/" + location.href.split('/').slice(-2).join('/') + "/transcript";

  $.ajax({
    url: transcriptPath,
    cache: false,
    success: function(html){
      let parser = new DOMParser();
      doc = parser.parseFromString(html, "text/html");

      let transcriptBody = doc.querySelector('.modal-body')

      $("#transcript_content").append(transcriptBody);
    }
  });
</script>
