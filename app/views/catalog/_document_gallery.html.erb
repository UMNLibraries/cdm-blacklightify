<% view_config = local_assigns[:view_config] || blacklight_config&.view_config(document_index_view_type) %>
<div class="container">
  <div id="documents" class="<%= (Array(view_config.classes || 'row-cols-2 row-cols-md-3') + ["row documents-#{view_config.key}"]).join(' ') %>">
    <% presenters = documents.map { |doc| Blacklight::DocumentPresenter.new(doc, self, blacklight_config) } %>
    <%= render view_config.document_component.with_collection(presenters, counter_offset: @response&.start || 0) %>
  </div>
</div>

