<% view_config = local_assigns[:view_config] || blacklight_config&.view_config(document_index_view_type) %>
<div class="container">
  <div id="documents" class="<%= (Array(view_config.classes || 'row-cols-2 row-cols-md-3') + ["row documents-#{view_config.key}"]).join(' ') %>">
    <% documents.each do |document| %>
      <div class="col document">
        <div class="card">
          <% if document.has_key?('object') %>
            <img class="card-img-top img-thumbnail" src="<%= document['object'] %>" alt="<%= document['title'] || 'Document' %>">
          <% end %>
          <div class="card-body">
            <h5 class="card-title">
              <% doc_id = document.respond_to?(:id) ? document.id : document %>
              <% doc_url = current_exhibit ? spotlight.exhibit_solr_document_path(current_exhibit, doc_id) : solr_document_path(doc_id) %>
              <%= link_to truncate(document['title'], length: 50), doc_url, class: 'document-link' %>
            </h5>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
