<dt class="d-flex align-items-start show-page-label blacklight-<%= field_name.parameterize %>" >
  <%= Umedia::LocalizedMetadataFieldComponent.new(field: field, show: true).label(locale: current_locale) %>

  <% if Umedia::LocalizedMetadataFieldComponent.new(field: field, show: true).tooltip_icon(locale: current_locale).to_s == "true" %>
  <% else %>
    <div
      data-toggle="tooltip"
      title="<%= Umedia::LocalizedMetadataFieldComponent.new(field: field, show: true).title_attribute(locale: current_locale) %>"
    >
      <span tabindex="0" class="tool-tip rounded-circle" role="tooltip">?</span>
    </div>
  <% end %>
</dt>

<% rendered = Array.wrap(field_presenter.render).reject { |value| value.blank? }.map { |rendered| field_presenter.field_config[:raw] ? raw(rendered) : rendered } %>
  <% if rendered.length == 1 %>
    <dd class="d-flex align-items-start show-page-label blacklight-<%= field_name.parameterize %> getty-format-name">
      <% if field_name == 'format_name' %>
          <% zipped_arr.each do |x| %>
            <span itemprop"types" >
              <a href='/catalog?q="<%= x[0] %>"&facet.field=format_name' class="d-flex align-items-start show-page-label"><%= x[0] %></a>
            </span>
            <div
              data-toggle="tooltip"
              title="<%= GettyJsonService.new(x[1]).data['subject_of'][0]['content'] %>"
            >
            <span tabindex="0" class="tool-tip rounded-circle" role="tooltip">?</span>
            </div>
          <% end %>
      <% else %>
        <%= safe_join(Array.wrap(rendered)) %>
      <% end %>
    </dd>
  <% elsif rendered.length > 1 %>
    <dd class="blacklight-<%= field_name.parameterize %> ">
      <% rendered.each do |value| %>
        <%= value %>,
      <% end %>
    </dd>
<% end -%>

<!-- move this out of this looped view . . . -->
<script>
  $('[data-toggle="tooltip"]').tooltip({ placement: 'top' });

  // escape tooltip and popover with ESC key
  $.fn.listenEscKeyToCloseOverlays = function () {
    return this.each(function () {
      if (("undefined" !== typeof $.fn.tooltip) || ("undefined" !== typeof $.fn.popover)) {
        document.addEventListener('keydown', function(e) {
          if ('Escape' === e.key) {
            const $openTooltips = $('.tooltip');
            const $openPopovers = $('.popover');

            if ($openPopovers.length || $openTooltips.length) {
              e.stopPropagation();
              $openTooltips.tooltip('hide');
              $openPopovers.popover('hide');
            }
          }
        }, true);
      }
    });
  };

  $(document).listenEscKeyToCloseOverlays();
</script>