<% @presenter = document_presenter(@document) %>
<% @page_title = t('blacklight.search.show.title', document_title: @presenter.html_title(locale: current_locale), application_name: application_name).html_safe %>
<% content_for(:head) { Blacklight::LinkAlternatePresenter.new(self, @document, {}).render.html_safe } %>

<%= render (blacklight_config.view_config(:show).document_component || Blacklight::DocumentComponent).new(
  presenter: @presenter,
  component: :div,
  title_component: :h1,
  show: true,
  locale: current_locale,
  partials: blacklight_config.view_config(:show).partials&.compact
) do |component| %>
  <% component.body do %>
    <%= render partial: 'show', locals: { document: @document } %>
  <% end %>
  
  <% component.footer do %>
    <% if @document.respond_to?(:export_as_openurl_ctx_kev) %>
      <!--
           // COinS, for Zotero among others.
      -->
      <span class="Z3988" title="<%= @document.export_as_openurl_ctx_kev(Deprecation.silence(Blacklight::RenderPartialsHelperBehavior) { document_partial_name(@document) }) %>"></span>
    <% end %>
  <%  end %>
<% end %>
