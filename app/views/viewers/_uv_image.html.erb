<% content_for(:head) do %>
  <%= javascript_include_tag "/uv/umd/UV.js" %>
  <%= stylesheet_link_tag "/app/assets/stylesheets/umedia/_umedia.scss" %>
<% end %>

<% if fullscreen? %>
  <div class="d-flex justify-content-center my-1">
    <%= link_to "Back to item page", solr_document_path %>
  </div>
<% end %>

<div id="uv" class="uv" style="<%= params[:fullscreen]? 'width: 100vw; height: 100vh;' : 'height: 50vh;' %>"></div>

<script>
  var uv = UV.init(
    "uv",
    {
      // manifest: "https://cdm16022.contentdm.oclc.org/iiif/2/<%= document.id %>/manifest.json",
      // wip: new manifest route
      manifest: "/iiif/<%= document.id %>/manifesttest.json",
      config: "/uv/uvconfig.json",
    },
  );
  // need to sort out uvconfig file and move these . . .
  uv.on("configure", function ({ config, cb }) {
    cb({
      options: {
        fullscreenEnabled: false,
        rightPanelEnabled: true,
        useArrowKeysToNavigate: true,
        termsOfUseEnabled: false,
      },
      modules: {
        downloadDialogue: {
          options: {
            selectionEnabled: false,
            downloadWholeImageLowResEnabled: false,
          },
          content: {
          }
        },
        footerPanel: {
          options: {
            fullscreenEnabled: false,
          }
        }
      }
    });
  });
</script>

<style>
  /* update download text */
  .uv .download .middle .content h2:nth-child(4) {
    color: transparent;
  }

  .uv .download .middle .content h2:nth-child(4):after {
    content: "Original File";
    color: black;
    margin-left: -64px;
  }
</style>