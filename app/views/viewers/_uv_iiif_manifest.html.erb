<% content_for(:head) do %>
  <%= javascript_include_tag "/uv/umd/UV.js" %>
  <%= stylesheet_link_tag "/app/assets/stylesheets/umedia/_umedia.scss" %>
  <%# <style>#uv { width: 70vw; height: 100vh; margin-bottom: 1rem; }</style> %>
<% end %>

<% if fullscreen? %>
  <div class="d-flex justify-content-center my-1">
    <%= link_to "Back to item page", solr_document_path %>
  </div>
<% end %>

<div id="uv" class="uv" style="<%= params[:fullscreen]? 'width: 100vw; height: 100vh;' : 'height: 50vh;' %>"></div>

<% uvconfig = UvPresenter.new(@document) %>

<script>
  var uv = UV.init(
    "uv",
    {
      manifest: "/iiif/<%= document.id %>/manifesttest.json",
      config: "/uv/uvconfig.json",
    },
  );
  // need to sort out uvconfig file and move these . . .
  uv.on("configure", function ({ config, cb }) {
    cb({
      options: {
        <%= uvconfig.paging_enabled %>,
        rightPanelEnabled: true,
        useArrowKeysToNavigate: true,
        termsOfUseEnabled: false
      },
      modules: {
        footerPanel: {
          options: {
            fullscreenEnabled: false,
          }
        },
        pagingHeaderPanel: {
          options: {
            autoCompleteBoxEnabled: false,
            imageSelectionBoxEnabled: true,
          }
        }
      }
    });
  });
</script>

<style>
  /* update download first heading text */
  .uv .download .middle .content h2:nth-child(2) {
    color: transparent;
  }
  .uv .download .middle .content h2:nth-child(2):before {
    content: "Individual Page";
    color: black;
  }
  /* hide option 3, lo-res image download */
  .uv .download .middle .content .options li:nth-child(3) {
    display: none;
  }
  /* current view download option text */
  .uv .download .middle .content ol.options:nth-child(3) .single:first-child button {
    color: transparent;
  }
  .uv .download .middle .content ol.options:nth-child(3) .single:first-child button:before {
    content: "Current view in window (jpg)";
  }
  /* full size image download option text */
  .uv .download .middle .content ol.options:nth-child(3) .single:nth-child(2) button {
    color: transparent;
  }
  .uv .download .middle .content ol.options:nth-child(3) .single:nth-child(2) button:before {
    content: "Full size image (jpg)";
  }
  /* all pages second heading text */
  .uv .download .middle .content h2:nth-child(4) {
    color: transparent;
  }
  .uv .download .middle .content h2:nth-child(4):before {
    content: "All Pages";
    color: black;
  }
  /* all pages download option text */
  .uv .download .middle .content ol.options:nth-child(5) li button {
    color: transparent;
  }
  .uv .download .middle .content ol.options:nth-child(5) li button:before {
    content: "Complete object (pdf)";
  }
  /* line height of list elements */
  .uv .download .middle .content ol.options li {
    padding: 0px;
    margin: 0 auto;
    height: 1.5rem;
  }
  /* link color */
  .uv .download .middle .content ol.options li button:before {
    color: #10819A;
  }
</style>