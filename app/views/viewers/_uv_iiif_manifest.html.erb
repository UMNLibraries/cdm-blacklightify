<% content_for(:head) do %>
  <%= javascript_include_tag "/uv/umd/UV.js" %>
  <%= stylesheet_link_tag "/uv/uv.css" %>
<% end %>

<% if fullscreen? %>
  <div class="d-flex justify-content-center my-1" id="fullscreen-link">
    <%= link_to "Back to item page", solr_document_path %>
  </div>
<% end %>

<div id="uv" class="uv uvCompound" style="<%= params[:fullscreen]? 'width: 99.25vw; height: 100vh;' : 'height: 65vh;' %>"></div>

<% uvconfig = UvPresenter.new(@document) %>

<script>
  iiifManifestConfig("<%= document.id %>")
</script>
