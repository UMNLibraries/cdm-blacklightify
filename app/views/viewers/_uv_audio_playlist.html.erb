<% borealis_doc = Umedia::BorealisDocument.new(document: document) %>

<% if fullscreen? %>
  <div class="d-flex justify-content-center my-1" id="fullscreen-link">
    <%= link_to "Back to item page", solr_document_path %>
  </div>
<% end %>

<div class="embed-responsive <%= fullscreen? ? 'embed-responsive-4by3' : 'embed-responsive-16by9'%>">
  <iframe 
    id="kaltura_player" 
    src="<%= kaltura_audio_playlist_url(borealis_doc.document._source['kaltura_audio_playlist']) %>"
  >
  </iframe>
</div>
