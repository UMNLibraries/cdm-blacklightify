<%#
  Custom facet limit partial for subject_fast_ssim field.
  Displays FAST subject labels instead of URIs in facet list.
  
  Renders facet items using the custom SubjectFastFacetItemPresenter
  which overrides the label to fetch FAST term labels from URIs.
%>

<div id="facet-<%= facet_field.parameterize %>" class="card facet-limit-active">
  <h3 class="card-header facet-subject_fast_ssim-header">
    <button class="btn btn-link" type="button" data-toggle="collapse" 
            data-target="#facet-<%= facet_field.parameterize %>-values"
            aria-expanded="<%= facet_field_presenter.collapsed? ? 'false' : 'true' %>"
            aria-controls="facet-<%= facet_field.parameterize %>-values">
      <%= facet_field_presenter.label %>
    </button>
  </h3>

  <div id="facet-<%= facet_field.parameterize %>-values" class="collapse <%= 'show' unless facet_field_presenter.collapsed? %>">
    <ul class="facet-values list-unstyled">
      <% facet_field_presenter.values.each do |facet_item_presenter| %>
        <li>
          <%# The custom presenter already fetches the FAST label %>
          <% label = facet_item_presenter.label %>
          
          <% if facet_item_presenter.selected? %>
            <span class="selected">
              <%= link_to label, facet_item_presenter.remove_href,
                          class: "remove", aria_label: "Remove #{label} filter" %>
              <span class="facet-count">(<%= facet_item_presenter.hits %>)</span>
            </span>
          <% else %>
            <%= link_to label, facet_item_presenter.href,
                        class: "facet-label", aria_label: "Add #{label} filter" %>
            <span class="facet-count">(<%= facet_item_presenter.hits %>)</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
