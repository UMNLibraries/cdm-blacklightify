<!DOCTYPE html>
<%= content_tag :html, class: 'no-js', **(try(:html_tag_attributes) || {}) do %>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <%= render partial: 'shared/analytics' %>
    
    <title><%= h(@page_title || application_name.to_s) %></title>
    <link href="<%= current_exhibit ? spotlight.opensearch_exhibit_catalog_url(current_exhibit, format: 'xml') : main_app.opensearch_catalog_url(format: 'xml') %>" title="<%= h(@page_title || application_name.to_str) %>" type="application/opensearchdescription+xml" rel="search"/>
    <%= favicon_link_tag 'favicon.ico' %>
    <% if current_exhibit %>
      <%= exhibit_stylesheet_link_tag "application" %>
    <% else %>
      <%= stylesheet_link_tag "application" %>
    <% end %>
    <%= content_for(:head) %>
    <%= javascript_include_tag "application" %>

    <%= description %>
    <%= twitter_card %>
    <%= opengraph %>
    <%= javascript_tag '$.fx.off = true;' if Rails.env.test? %> 

    <%= csrf_meta_tags %>
  </head>
  <body class="<%= render_body_class %>">
    <header>
      <div id="skip-link">
        <% if should_render_spotlight_search_bar? %>
          <%= link_to t('blacklight.skip_links.search_field'), '#search_field', class: 'element-invisible element-focusable rounded-bottom py-2 px-3', data: { turbolinks: 'false' } %>
        <% end %>
        <%= link_to t('blacklight.skip_links.main_content'), '#main-container', class: 'element-invisible element-focusable rounded-bottom py-2 px-3', data: { turbolinks: 'false' } %>
        <%= content_for(:skip_links) %>
      </div>
      <%# renders on main page only %>
      <%= render partial: 'shared/header_navbar' if current_page?(root_path) %>
      <%= render partial: 'shared/about' if current_page?(root_path) %>
      <%= render partial: 'shared/content_notice' if current_page?(root_path) %>
    </header>

    <%= render 'shared/spotlight_header' if !current_page?(root_path) %> 
    <%= render partial: 'shared/masthead' %>
    
    <main role="main" aria-label="<%= t('blacklight.main.aria.main_container') %>">
      <%= render partial: 'shared/flash_msg', layout: 'shared/flash_messages' %>

      <% if current_page?(root_path) %>
        <%= render partial: 'shared/main_page_spotlight_sections' %>
      <% else %>
        <div class="container">
          <div class="row" id="spotlight">
            <div>
              <%# If q includes set_spec:*, show the matched Spotlight long_description context. %>
              <% if spotlight_search_long_description.present? %>
                <% if spotlight_search_title.present? %>
                  <h3><%= h(spotlight_search_title) %></h3>
                <% end %>
                <p><%= h(spotlight_search_long_description) %></p>
              <% end %>
            </div>
          </div>
        </div>
        <div class="container">
          <div class="row" id="spotlight">
            <%= content_for?(:content) ? yield(:content) : yield %>
          </div>
        </div>
      <% end %>
    </main>
    
    <%= render partial: 'shared/footer' %>
    <%= render partial: 'shared/modal' %>
  </body>
<% end %>
