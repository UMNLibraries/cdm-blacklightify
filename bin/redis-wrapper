#!/bin/sh

redis_url=https://download.redis.io/redis-stable.tar.gz
tmp_dir="$(dirname $0)/../tmp"
redis_tgz="$tmp_dir/$(basename $redis_url)"
src_dir="$tmp_dir/redis-stable"
redis_bin="$src_dir/src/redis-server"
redis_port="${REDIS_WRAPPER_PORT:-63799}"
redis_maxmemory_policy="${REDIS_WRAPPER_MAXMEMORY_POLICY:-noeviction}"

if [ ! -f "$redis_bin" ]; then
  echo "Downloading redis"
  curl --output "$redis_tgz" "$redis_url"
  tar -zxf "$redis_tgz" -C "$tmp_dir"
  cd "$src_dir"
  make
  cd -
fi

# If a redis instance hung around on this port, kill it and give it a second to shut down
lsof -t -i tcp@127.0.0.1:$redis_port | xargs -r kill && sleep 1
echo "Starting redis"
mkdir -p "$tmp_dir/redis-data-$redis_port"
$redis_bin --dir "$tmp_dir/redis-data-$redis_port" --dbfilename redis-dev-dump.rdb --bind 127.0.0.1 --port $redis_port --maxmemory-policy $redis_maxmemory_policy --daemonize no --supervised no --pidfile "$tmp_dir/redis-data/redis-$redis_port.pid"
